model NovelSource {
  id       String        @id @default(uuid())
  name     String
  url      String
  stars    Int
  visits   SourceVisit[]
  visitors UserProfile[] @relation("NovelSourceToUserProfile")
  novels   Novel[]       @relation("NovelToNovelSource")

  @@schema("public")
}

model SourceVisit {
  id          String      @id @default(uuid())
  userId      String      @db.Uuid
  sourceId    String
  count       Int
  startedAt   DateTime    @default(now())
  lastVisited DateTime    @updatedAt
  readings    ReadNovel[]
  source      NovelSource @relation(fields: [sourceId], references: [id])
  user        UserProfile @relation(fields: [userId], references: [id])

  @@unique([userId, sourceId])
  @@schema("public")
}
