model Novel {
  id          String         @id @default(cuid())
  title       String
  author      String
  description String
  coverImage  String
  genre       String[]
  publishedAt DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  chapters    NovelChapter[]
  readers     ReadNovel[]
  sources     NovelSource[]  @relation("NovelToNovelSource")

  @@index([title], map: "idx_novel_title")
  @@index([author], map: "idx_novel_author")
  @@schema("public")
}

model NovelChapter {
  id            String        @id @default(cuid())
  number        Int
  title         String
  content       String
  novelId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookmarks     Bookmark[]
  novel         Novel         @relation(fields: [novelId], references: [id])
  readings      ReadChapter[] @relation("ReadChapter")
  currentReads  ReadNovel[]   @relation("CurrentReadChapter")
  previousReads ReadNovel[]   @relation("PreviousReadChapter")

  @@unique([novelId, number])
  @@schema("public")
}
